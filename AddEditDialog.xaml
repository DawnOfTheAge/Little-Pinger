<Window x:Class="LittlePinger.AddEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Ping Entry"
        FocusManager.FocusedElement="{Binding ElementName=TxtName}"
        Width="400" Height="265"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#FAFAFA">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="BorderBrush" Value="#BDBDBD"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="#424242"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="115"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Name -->
        <Label Grid.Row="0" Grid.Column="0" Content="Name:"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtName"/>

        <!-- IP / Hostname -->
        <Label Grid.Row="2" Grid.Column="0" Content="IP / Hostname:"/>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtIp"
                 TextChanged="TxtIp_TextChanged"/>

        <!-- Interval -->
        <Label Grid.Row="4" Grid.Column="0" Content="Interval (ms):"/>
        <TextBox Grid.Row="4" Grid.Column="1" x:Name="TxtInterval"/>

        <!-- Timeout -->
        <Label Grid.Row="6" Grid.Column="0" Content="Timeout (ms):"/>
        <TextBox Grid.Row="6" Grid.Column="1" x:Name="TxtTimeout"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="8" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnOk" Content="OK"
                    Width="82" Height="28" Margin="0,0,8,0"
                    IsDefault="True"
                    Background="#2196F3"
                    Style="{StaticResource ActionButton}"
                    Click="BtnOk_Click"/>
            <Button Content="Cancel"
                    Width="82" Height="28"
                    IsCancel="True"
                    Background="#757575"
                    Style="{StaticResource ActionButton}"/>
        </StackPanel>
    </Grid>
</Window>
