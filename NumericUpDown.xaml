<UserControl x:Class="LittlePinger.NumericUpDown"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Border Background="#2D2D2D"
            BorderBrush="#546E7A"
            BorderThickness="1"
            CornerRadius="4">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
            </Grid.ColumnDefinitions>

            <!-- Value text box -->
            <TextBox x:Name="ValueBox"
                     Grid.Column="0"
                     Background="Transparent"
                     Foreground="#ECEFF1"
                     BorderThickness="0"
                     VerticalAlignment="Center"
                     TextAlignment="Right"
                     Padding="6,4,2,4"
                     CaretBrush="#ECEFF1"
                     Text="{Binding Value, ElementName=Root, UpdateSourceTrigger=PropertyChanged}"
                     PreviewTextInput="ValueBox_PreviewTextInput"
                     LostFocus="ValueBox_LostFocus"/>

            <!-- Up / Down buttons -->
            <StackPanel Grid.Column="1" Orientation="Vertical">
                <RepeatButton x:Name="UpBtn"
                              Content="▲"
                              FontSize="7"
                              Background="#37474F"
                              Foreground="#90A4AE"
                              BorderThickness="0"
                              Padding="0"
                              Height="13"
                              Cursor="Hand"
                              Click="UpBtn_Click"
                              Focusable="False"/>
                <RepeatButton x:Name="DownBtn"
                              Content="▼"
                              FontSize="7"
                              Background="#37474F"
                              Foreground="#90A4AE"
                              BorderThickness="0"
                              Padding="0"
                              Height="13"
                              Cursor="Hand"
                              Click="DownBtn_Click"
                              Focusable="False"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
